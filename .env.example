# ===== قاعدة البيانات (PostgreSQL على Neon) =====
# من لوحة Neon: Connect ← انسخ Connection string (يكفي رابط واحد في DATABASE_URL).
# DATABASE_URL: الاتصال عبر pooler (يحتوي -pooler في اسم المضيف) — للتطبيق
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED: الاتصال المباشر — للترحيلات (prisma migrate deploy)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ===== الأمان =====
# مفتاح سري لتوقيع جلسة الدخول — قيمة عشوائية طويلة (32 حرفاً على الأقل). ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret-value-please"

# حساب المالك عند أول دخول (يُنشأ مرة واحدة فقط إن لم يوجد مالك). بعد الدخول غيّر كلمة المرور من الإعدادات.
# كلمة المرور: 8 أحرف على الأقل تحتوي أرقاماً وحروفاً.
OWNER_USERNAME="owner"
OWNER_PASSWORD=""

# سر يحمي المسار /api/cron (لاستدعائه من خدمة جدولة خارجية عند الحاجة)
CRON_SECRET="change-me-too"

# ===== التشغيل المحلي فقط (npm start على جهاز الشركة) =====
HOST="127.0.0.1"
PORT="3000"
BACKUP_DIR="./backups"
LOCAL_NETWORK_ONLY="true"
COOKIE_SECURE="false"
