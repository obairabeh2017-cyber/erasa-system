# ===== شركة ايراسا — إعدادات التشغيل على جهاز الشركة =====

# مفتاح سري لتوقيع جلسة الدخول — قيمة عشوائية طويلة (32 حرفاً على الأقل).
# start.bat يولّده تلقائياً أول مرة. أو ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret-value-please"

# حساب المالك: يُنشأ تلقائياً عند أول دخول إن لم يوجد مالك.
# كلمة المرور: 8 أحرف على الأقل تحتوي أرقاماً وحروفاً. بعد الدخول يمكنك تغييرها من الإعدادات.
OWNER_USERNAME="owner"
OWNER_PASSWORD=""

# 0.0.0.0 = يفتح من هذا الجهاز ومن الهاتف على نفس Wi-Fi | 127.0.0.1 = هذا الجهاز فقط
HOST="0.0.0.0"
PORT="3000"

# يرفض أي اتصال من خارج الشبكة المحلية الخاصة (اتركه true)
LOCAL_NETWORK_ONLY="true"
COOKIE_SECURE="false"

# النسخ الاحتياطية التلقائية (ملفات JSON كل 24 ساعة) تُحفظ هنا
BACKUP_DIR="./backups"

# ===== قاعدة البيانات =====
# اتركها فارغة: يستخدم البرنامج قاعدة بيانات مدمجة في المجلد data/pglite (لا تحتاج تثبيت أي شيء).
# (اختياري) لاستخدام قاعدة PostgreSQL خارجية مثل Neon ضع رابطها هنا:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# سر يحمي المسار /api/cron (اختياري)
CRON_SECRET="change-me-too"
