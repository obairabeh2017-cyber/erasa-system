# مسار قاعدة البيانات (نسبةً إلى مجلد prisma). لا تضعه داخل مجلد public أبداً.
DATABASE_URL="file:../data/furniture.db"

# مفتاح سري لتوقيع جلسة الدخول — غيّره إلى قيمة عشوائية طويلة (32 حرفاً على الأقل)
# يمكنك توليده بالأمر:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret-value-please"

# عنوان الاستماع: 127.0.0.1 = هذا الجهاز فقط | 0.0.0.0 = الشبكة المحلية (للهاتف عبر Wi-Fi)
HOST="127.0.0.1"
PORT="3000"

# مجلدات النسخ الاحتياطية والمرفقات (خارج مجلد public)
BACKUP_DIR="./backups"
STORAGE_DIR="./storage"

# اسمح بالوصول فقط من عناوين الشبكة المحلية الخاصة (true موصى به)
LOCAL_NETWORK_ONLY="true"

# اجعلها true فقط إذا كان التطبيق يُقدَّم عبر HTTPS (مثلاً خلف Tailscale HTTPS)
COOKIE_SECURE="false"
